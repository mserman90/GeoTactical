# GeoTactical Telemetry Monitor - Environment Configuration
# -------------------------------------------------------------
# NOTE: GeoTactical is designed to be 100% FREE & ZERO-KEY by default!
# All GIS layers (MapLibre + OpenFreeMap + ESRI + OSM), AI reasoning (Pollinations.ai),
# audio synthesis (Web Audio API), and voice annunciator (Web Speech API) work out-of-the-box
# without requiring ANY API keys or account registrations.

# Optional: Port configuration for local Vite development server
VITE_PORT=3000

# Optional: Custom hosting base URL (defaults to './' in production for GitHub Pages compatibility)
VITE_BASE_URL="/"
